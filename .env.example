# Supabase (existing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for notifications, logs, and OTP challenges
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (WhatsApp + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# e.g. whatsapp:+14155238886 (sandbox) or your approved WhatsApp sender
TWILIO_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_ENABLED=false

# Optional: public site URL for deep links (defaults to https://researchflowafrica.com)
NEXT_PUBLIC_APP_URL=https://researchflowafrica.com

# Cron (Vercel Cron should send Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Optional: pepper for hashing phone OTP codes (defaults to CRON_SECRET if unset)
PHONE_OTP_SECRET=
